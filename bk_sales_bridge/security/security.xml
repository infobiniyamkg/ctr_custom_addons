<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- =========================================================
         BK Sales Bridge Application Category
         ========================================================= -->
    <record id="module_category_bk_sales_bridge" model="ir.module.category">
        <field name="name">BK Sales Bridge</field>
        <field name="sequence">20</field>
    </record>


    <!-- =========================================================
         BK Sales Bridge Privilege

         This is the Odoo 19 replacement for putting groups
         directly under category_id.
         ========================================================= -->
    <record id="privilege_bk_sales_bridge" model="res.groups.privilege">
        <field name="name">BK Sales Bridge</field>
        <field name="category_id" ref="module_category_bk_sales_bridge"/>
        <field name="sequence">20</field>
        <field name="placeholder">No Access</field>
        <field name="description">
            Controls access to the BK Sales Bridge POS sales integration.
        </field>
    </record>


    <!-- =========================================================
         POS Sales Import User
         ========================================================= -->
    <record id="group_bk_sales_user" model="res.groups">
        <field name="name">User</field>
        <field name="privilege_id" ref="privilege_bk_sales_bridge"/>
        <field name="sequence">10</field>

        <field name="comment">
            Can import and view staged POS sales, validate batches,
            and view reports. Cannot configure POS sources, edit
            product mappings, post sales, or view API keys.
        </field>
    </record>


    <!-- =========================================================
         POS Sales Import Manager
         ========================================================= -->
    <record id="group_bk_sales_manager" model="res.groups">
        <field name="name">Administrator</field>
        <field name="privilege_id" ref="privilege_bk_sales_bridge"/>
        <field name="sequence">20</field>

        <!-- Administrator inherits User -->
        <field name="implied_ids"
               eval="[(4, ref('group_bk_sales_user'))]"/>

        <field name="comment">
            Full access to BK Sales Bridge including POS source
            configuration, product mapping, batch validation,
            and posting sales to native Odoo Sales.
        </field>
    </record>


    <!-- =========================================================
         POS Source - Administrator Only
         ========================================================= -->
    <record id="rule_bk_pos_source_manager_only" model="ir.rule">
        <field name="name">BK POS Source: Administrators Only</field>
        <field name="model_id" ref="model_bk_pos_source"/>

        <field name="domain_force">[(1, '=', 1)]</field>

        <field name="groups"
               eval="[(4, ref('group_bk_sales_manager'))]"/>

        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

</odoo>