<odoo>
    <!-- Root menu -->
    <menuitem id="menu_bk_sales_bridge_root" name="POS Bridge" sequence="100"/>

    <!-- Sales Import submenu -->
    <menuitem id="menu_bk_sales_import" name="Sales Import"
