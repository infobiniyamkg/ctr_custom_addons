<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_bk_sales_transaction_form" model="ir.ui.view">
        <field name="name">bk.sales.transaction.form</field>
        <field name="model">bk.sales.transaction</field>
        <field name="arch" type="xml">
            <form string="POS Sales Transaction">
                <sheet>
                    <!-- Transaction Reference -->
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>

                    <!-- Main Transaction Information -->

                        <group>
                            <group>
                                <field name="external_ref"/>
                                <field name="sales_type"/>
                                <field name="date" />
                                <field name="issued_datetime" invisible="1"/>
                                <field name="imported" invisible="1"/>
                                <field name="pos_source_id"/>
                                <field name="batch_id" invisible="1"/>
                            </group>
                            <group>
                                <field name="currency_code"/>
                                <field name="base_currency_rate"/>
                                <field name="subtotal"/>
                                <field name="tax_total"/>
                                <field name="grand_total"/>

                            </group>
                        </group>




                    <!-- Sales Lines -->
                    <notebook>
                        <page string="Sales Lines" name="sales_lines">

                            <field name="line_ids">
                                <list create="0" delete="0">
                                    <field name="external_code"/>
                                    <field name="external_name"/>
                                    <field name="product_id"/>

                                    <field name="sold_qty"/>
                                    <field name="unit_price"/>

                                    <field name="amount_in_currency"/>
                                    <field name="net_sales_value"/>
                                    <field name="net_sales_value_in_currency"/>

                                    <field name="current_cost"/>
                                    <field name="total_cost"/>

                                    <field name="margin_value"/>
                                    <field name="margin_pct"/>

                                    <field name="flag"/>
                                </list>
                            </field>

                        </page>
                    </notebook>
                    <group col="4">
                        <field name="device_name"/>
                        <field name="shift_number"/>
                        <field name="fs_number"/>
                        <field name="user_name"/>
                           <field name="line_count" readonly="1"/>
                    </group>
                </sheet>

            </form>
        </field>
    </record>

    <record id="view_bk_bk_sales_transaction_list" model="ir.ui.view">
        <field name="name">bk.sales.transaction.list</field>
        <field name="model">bk.sales.transaction</field>
        <field name="arch" type="xml">
            <list string="Transaction Lines" default_order="issued_datetime desc">
                <field name="date" string="Date"/>
                <field name="external_ref" string="Ref#"/>
                <field name="batch_id" optional="hide"/>
                <field name="pos_source_id"/>
                <field name="device_name" string="Device" optional="hidden"/>
                <field name="fs_number" optional="hide" string="FS#"/>

                <field name="shift_number" optional="hide"/>
                <field name="user_name" optional="hide"/>
                <field name="subtotal" string="Sub Total"/>
                <field name="tax_total" string="Tax"/>
                <field name="grand_total" string="Grand Total"/>
                <field name="line_count" optional="hide"/>
                <field name="imported" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_bk_bk_sales_transaction_search" model="ir.ui.view">
        <field name="name">bk.sales.transaction.search</field>
        <field name="model">bk.sales.transaction</field>
        <field name="arch" type="xml">
            <search string="Sales Transaction">
                <field name="external_ref"/>
                <field name="device_name"/>
                <field name="shift_number"/>
                <field name="pos_source_id"/>
                <field name="batch_id"/>
                <filter string="Today"
                        name="today"
                        domain="[('date','=',context_today())]"/>

                <separator/>

                <group>
                    <filter string="Date" name="date"
                            context="{'group_by':'date'}"/>
                    <filter string="POS Source" name="pos_source_id"
                            context="{'group_by':'pos_source_id'}"/>


                </group>

            </search>
        </field>
    </record>

    <record id="view_bk_bk_sales_transaction_pivot" model="ir.ui.view">
        <field name="name">bk.sales.transaction.pivot</field>
        <field name="model">bk.sales.transaction</field>
        <field name="arch" type="xml">
            <pivot string="Sales Analysis">
                <field name="date" type="row" interval="month"/>
                <field name="subtotal" type="measure"/>
                <field name="grand_total" type="measure"/>
                <field name="tax_total" type="measure"/>

            </pivot>
        </field>
    </record>

    <record id="action_bk_bk_sales_transaction" model="ir.actions.act_window">
        <field name="name">Sales Transactions</field>
        <field name="res_model">bk.sales.transaction</field>
        <field name="view_mode">list,pivot,form</field>
        <field name="search_view_id" ref="view_bk_bk_sales_transaction_search"/>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Sales Lines
            </p>
            <p>
                Review imported POS sales lines
            </p>
        </field>
    </record>

</odoo>