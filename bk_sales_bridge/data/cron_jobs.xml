        <record id="cron_bk_cleanup_sync_logs" model="ir.cron">
            <field name="name">BK: Clean Old Sync Logs (weekly)</field>
            <field name="model_id" ref="model_bk_pos_sync_log"/>
            <field name="state">code</field>
            <field name="code">cutoff_date = datetime.datetime.now() - datetime.timedelta(days=9)
old_logs = env['bk.pos.sync.log'].search([('create_date', '&lt;', cutoff_date)])
count = len(old_logs)
old_logs.unlink()
log(f"Deleted {count} old sync logs", level='info')

            </field>
            <field name="interval_number">1</field>
            <field name="interval_type">weeks</field>
            <field name="active" eval="True"/>
        </record>
    </data>
