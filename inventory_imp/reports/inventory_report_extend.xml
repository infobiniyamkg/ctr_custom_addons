<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <template id="inventory_imp_extend" inherit_id="stock.report_picking">
        <!-- Keep reference number in one line -->
        <xpath expr="//h2[@t-field='o.name']" position="attributes">
            <attribute name="style">
                white-space: nowrap;
                font-size: 18px;
            </attribute>
        </xpath>

        <!-- Allow product column to take more space -->
        <xpath expr="//table[contains(@class,'o_main_table')]" position="attributes">
            <attribute name="style">   width:100%;    table-layout:auto;
            </attribute>
        </xpath>

        <!-- Initialize counter -->
        <xpath expr="//table[contains(@class,'o_main_table')]" position="before">
            <t t-set="counter" t-value="1"/>
        </xpath>

        <!-- Add No column -->
        <xpath expr="//table[contains(@class,'o_main_table')]/thead/tr/th[@name='th_product']"
               position="before">
            <th name="seq_no"
                style="width:35px;text-align:center;">
                <strong>No</strong>
            </th>

        </xpath>


        <!-- Add Customs ID column -->
        <xpath expr="//table[contains(@class,'o_main_table')]/thead/tr"
               position="inside">

            <th name="th_imp_tax"
                style="width:70px;text-align:center;">
                <strong>Customs Id</strong>
            </th>
        </xpath>

        <!-- Sequence value -->
        <xpath expr="//table[contains(@class,'o_main_table')]/tbody/t/tr/td[1]"     position="before">
            <td style="width:35px;text-align:center;">
                <span t-esc="counter"/>
            </td>
            <t t-set="counter" t-value="counter + 1"/>

        </xpath>


        <!-- Customs value -->
        <xpath expr="//table[contains(@class,'o_main_table')]/tbody/t/tr"
               position="inside">

            <td style="width:70px;text-align:center;">
                <span t-field="move.customs_id"/>
            </td>

        </xpath>


        <!-- Approval footer inside existing page -->
        <xpath expr="//div[hasclass('page')]//p[@t-field='o.note']"
               position="after">


            <div class="row mt-5"
                 style="page-break-inside: avoid; clear:both;">


                <div class="col-4">

                    <h5>Prepared By</h5>

                    <br/>

                    <p>Signature:_________________________</p>
                    <p>Date: _____________________________</p>
                    <p>Name: _____________________________</p>

                </div>


                <div class="col-4">

                    <h5>Received By</h5>

                    <br/>

                    <p>Signature: __________________</p>
                    <p>Date: _______________________</p>
                    <p>Name: _______________________</p>

                </div>


                <div class="col-4">

                    <h5>Authorized By</h5>

                    <br/>

                    <p>Signature: ______________________</p>
                    <p>Date: ___________________________</p>
                    <p>Name: ___________________________</p>

                </div>


            </div>



            <t t-if="o.picking_type_id.code == 'internal'">

                <div class="mt-4">

                    <h5>Outgoing Custom</h5>

                    <br/>
                    <p>Signature: ______________________</p>
                    <p>Date: ___________________________</p>
                    <p>Name: ___________________________</p>

                </div>

            </t>


        </xpath>


    </template>

    <template inherit_id="stock.report_delivery_document" id="inventory_imp_extend_delivery">
        <xpath expr="//table[@name='stock_move_table']/thead/tr" position="inside">
            <th name="th_imp_tax">
                Customs Id
            </th>

        </xpath>

        <xpath expr="//table[@name='stock_move_table']/thead/tr/th[1]" position="before">
            <th name="seq_no">
                NO
            </th>
        </xpath>
        <xpath expr="//table[@name='stock_move_table']/tbody" position="before">
            <t t-set="counter" t-value="1"/>
        </xpath>
        <xpath expr="//table[@name='stock_move_table']/tbody/tr/td[1]" position="before">
            <td>
                <span t-esc="counter"/>
                <t t-set="counter" t-value="counter + 1"/>
            </td>
        </xpath>
        <xpath expr="//table[@name='stock_move_table']/tbody/tr" position="inside">
            <td t-esc="move.customs_id"/>

        </xpath>

        <xpath expr="//div[hasclass('page')]" position="after">
            <div class="container-fluid m-0" style="page-break-inside: avoid">

                <div class="container-fluid d-flex flex-row">
                    <div class="me-5">
                        <h5>Prepared By</h5>
                        <br/>
                        <br/>
                        <p>Signature: ____________________________</p>
                        <p>Date: ____________________________</p>
                        <p>Name: ____________________________</p>
                    </div>
                    <div class="me-5">
                        <h5>Received By</h5>
                        <br/>
                        <br/>
                        <p>Signature: ____________________________</p>
                        <p>Date: ____________________________</p>
                        <p>Name: ____________________________</p>

                    </div>

                    <div class="me-5">
                        <h5>Authorized By</h5>
                        <br/>
                        <br/>
                        <p>Signature: ____________________________</p>
                        <p>Date: ____________________________</p>
                        <p>Name: ____________________________</p>
                    </div>
                </div>
                <t t-if="o.picking_type_id.code == 'internal'">
                    <br/>
                <div class="container mt-5">
                    <div>
                        <h5>Outgoing Custom</h5>
                        <br/>
                        <br/>
                        <p>Signature: ____________________________</p>
                        <p>Date: ____________________________</p>
                        <p>Name: ____________________________</p>
                    </div>
                </div>
                </t>
            </div>
        </xpath>

    </template>
</odoo>